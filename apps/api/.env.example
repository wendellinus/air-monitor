NODE_ENV=development
PORT=8080
TZ=Asia/Shanghai

# Postgres (from pgsql.*)
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/air_monitor?schema=public&sslmode=disable

# JWT (from jwt.*; refresh-token flow is new in NestJS)
JWT_ACCESS_SECRET=replace-with-your-signing-key
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=air-monitor

# Seed users (production bootstrap; used by `pnpm prisma:seed`)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_OPERATOR_USERNAME=operator
INITIAL_OPERATOR_PASSWORD=change-me

# Redis (from redis.*)
REDIS_URL=redis://127.0.0.1:6379/0

# QWeather (from qweather.*)
QWEATHER_HOST=https://nf5xmdy8n7.re.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_PUBLIC_ID=CHGUYCCGQR
QWEATHER_PROJECT_ID=3NKPCUCJRC
# Put PEM as a single env var with \n escapes (dotenv-friendly):
QWEATHER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Scheduled cache refresh (top cities)
CACHE_REFRESH_ENABLED=false
CACHE_REFRESH_SCHEDULE=0 */50 * * * *
# Example: [{"name":"cn","count":20},{"name":"world","count":10}]
CACHE_REFRESH_REGIONS_JSON=

# Scheduled alert sync (notice)
ALERT_SYNC_ENABLED=false
ALERT_SYNC_SCHEDULE=0 */30 * * * *
# Example: [{"name":"beijing","lat":"39.9042","lon":"116.4074"}]
ALERT_SYNC_LOCATIONS_JSON=
