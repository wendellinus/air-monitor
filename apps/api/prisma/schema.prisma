generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  operator
  admin
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(20)
  passwordHash String
  email        String?  @db.VarChar(64)
  phone        String?  @db.VarChar(16)
  isActive     Boolean  @default(true)
  role         UserRole @default(user)
  locale       String   @default("zh-CN") @db.VarChar(10)
  tokenVersion Int      @default(0)
  // If set, any token with iat older than this should be treated as invalid.
  tokenInvalidBefore DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  refreshTokens RefreshToken[]
  favoriteCities UserFavoriteCity[]
  dashboardLayout UserDashboardLayout?
  deniedPermissions UserDeniedPermission[]

  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  jti       String   @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model City {
  id      Int    @id @default(autoincrement())
  cityId  String @unique @db.VarChar(20)
  name    String @db.VarChar(50)
  lat     String @db.VarChar(20)
  lon     String @db.VarChar(20)
  adm2    String @db.VarChar(50)
  adm1    String @db.VarChar(50)
  country String @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favoritedBy UserFavoriteCity[]
}

model UserFavoriteCity {
  userId Int
  cityId String   @db.VarChar(20)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@id([userId, cityId])
  @@index([cityId])
  @@index([createdAt])
}

model UserDashboardLayout {
  userId    Int      @id
  layout    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  key       String  @id @db.VarChar(100)
  label     String  @db.VarChar(100)
  type      String  @db.VarChar(20)
  parentKey String? @db.VarChar(100)
  sort      Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Permission?  @relation("PermissionParent", fields: [parentKey], references: [key], onDelete: SetNull)
  children Permission[] @relation("PermissionParent")
  roles    RolePermission[]
  userDeniedPermissions UserDeniedPermission[]

  @@index([parentKey])
  @@index([sort])
}

model RolePermission {
  role          UserRole
  permissionKey String   @db.VarChar(100)
  createdAt     DateTime @default(now())

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@index([permissionKey])
}

model UserDeniedPermission {
  userId        Int
  permissionKey String   @db.VarChar(100)
  createdAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@index([permissionKey])
}

model AirQualityLog {
  id       Int      @id @default(autoincrement())
  cityId   String   @db.VarChar(20)
  pubTime  DateTime
  aqi      Int
  level    String   @db.VarChar(10)
  category String   @db.VarChar(20)
  primary  String?  @db.VarChar(50)
  pm10     Float
  pm2p5    Float
  no2      Float
  so2      Float
  co       Float
  o3       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([pubTime])
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  content   String?
  createdByName String? @db.VarChar(20)
  startTime DateTime
  endTime   DateTime
  status    String   @default("draft")
  level     String   @default("info")
  alertId   String?  @unique @db.VarChar(50)
  eventType String?  @db.VarChar(50)
  severity  String?  @db.VarChar(20)
  colorCode String?  @db.VarChar(20)
  source    String   @default("manual") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderAccountSnapshot {
  id           Int      @id @default(autoincrement())
  provider     String   @db.VarChar(20)
  source       String   @default("live") @db.VarChar(20)
  snapshotAt   DateTime @default(now())
  balance      Decimal? @db.Decimal(20, 4)
  requestCount Int?
  quotaLimit   Int?
  quotaUsed    Int?
  usageRate    Decimal? @db.Decimal(8, 6)
  raw          Json
  createdAt    DateTime @default(now())

  @@index([provider, snapshotAt(sort: Desc)])
}

model ProviderAccountMetricPoint {
  id        Int      @id @default(autoincrement())
  provider  String   @db.VarChar(20)
  metricKey String   @db.VarChar(32)
  bucket    String   @db.VarChar(10)
  time      DateTime
  value     Decimal  @db.Decimal(20, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, metricKey, bucket, time])
  @@index([provider, metricKey, time(sort: Desc)])
}

model SystemRuntimeConfig {
  id              Int      @id
  pollingInterval Int      @default(60000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
