# AMap Web JS API Key
VITE_AMAP_KEY=replace-with-your-amap-key
# AMap Web JS Security JsCode
VITE_AMAP_SECURITY_JS_CODE=replace-with-your-amap-security-jscode
# Optional: proxy API requests to a custom dev API origin.
VITE_API_PROXY_TARGET=http://localhost:8080
# Optional: serve Vite over HTTPS by pointing to a local cert and key.
VITE_DEV_SSL_CERT_PATH=
VITE_DEV_SSL_KEY_PATH=
