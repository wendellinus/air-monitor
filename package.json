{
  "name": "air-monitor-monorepo",
  "private": true,
  "version": "0.1.0",
  "pnpm": {
    "overrides": {
      "cron": "3.2.1"
    }
  },
  "scripts": {
    "setup": "pnpm run prisma:migrate:dev",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @air-monitor/api dev",
    "dev:web": "pnpm --filter @air-monitor/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:api": "pnpm --filter @air-monitor/shared build && pnpm --filter @air-monitor/api build",
    "build:web": "pnpm --filter @air-monitor/shared build && pnpm --filter @air-monitor/web build",
    "lint": "pnpm --filter @air-monitor/api lint",
    "format": "pnpm --filter @air-monitor/api format",
    "test": "pnpm --filter @air-monitor/shared build && pnpm --filter @air-monitor/api test",
    "test:e2e": "pnpm --filter @air-monitor/api test:e2e",
    "prisma:generate": "pnpm --filter @air-monitor/api prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @air-monitor/api prisma:migrate:dev",
    "prisma:seed": "pnpm --filter @air-monitor/api prisma:seed",
    "prisma:studio": "pnpm --filter @air-monitor/api prisma:studio"
  }
}
